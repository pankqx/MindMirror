# Copy this file to .env and paste your key. Never commit .env.
GROQ_API_KEY=gsk_paste_your_key_here
PORT=8787
STT_MODEL=whisper-large-v3-turbo
CHAT_MODEL=openai/gpt-oss-20b
TTS_VOICE=en-IN-NeerjaNeural
# Set to 1 to test the whole path without internet or a key
MOCK_AI=0

# Optional: replies from OpenRouter (Groq stays for listening). Leave empty to use Groq for both.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
